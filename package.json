{
  "name": "@appport/screen-relay",
  "version": "0.2.0",
  "description": "Stream a desktop to a browser and control it from a CLI and a Node SDK.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkendel1/screen-relay.git"
  },
  "type": "module",
  "bin": {
    "screen-relay": "dist/cli/relay.mjs"
  },
  "files": [
    "dist",
    "skills",
    "packages.tsv",
    "Makefile",
    "src/engine",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./provider": {
      "types": "./dist/app/provider.d.ts",
      "import": "./dist/app/provider.js"
    },
    "./viewer": {
      "types": "./dist/stream/attach.d.ts",
      "import": "./dist/stream/attach.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/viewer.mjs",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@appport/authorization": "1.2.1",
    "@appport/core": "1.9.0",
    "@appport/protocol": "1.6.0",
    "@appport/schema": "1.2.0",
    "@types/node": "26.6.6",
    "agent-browser": "0.42.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@appport/core": "^1.9.0",
    "@appport/protocol": "^1.6.0",
    "@appport/schema": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "@appport/core": {
      "optional": true
    },
    "@appport/protocol": {
      "optional": true
    },
    "@appport/schema": {
      "optional": true
    }
  }
}
